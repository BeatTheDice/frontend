{
  "openapi": "3.1.0",
  "info": {
    "title": "Beat The Dice Backend",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/start": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Start",
        "operationId": "start_runs_start_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStartResponse"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/claim": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Claim",
        "operationId": "claim_runs__run_id__claim_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunClaimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunClaimResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/score": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Score",
        "operationId": "score_runs__run_id__score_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreSubmitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreSubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/leaderboard": {
      "get": {
        "tags": [
          "leaderboard"
        ],
        "summary": "Leaderboard",
        "operationId": "leaderboard_leaderboard_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/me/scores": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Scores",
        "operationId": "scores_me_scores_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalScoresResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/me/best-score": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Best Score",
        "operationId": "best_score_me_best_score_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NullableBestScoreResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "AuthRequest"
      },
      "BestScoreResponse": {
        "properties": {
          "completed_levels": {
            "type": "integer",
            "title": "Completed Levels"
          },
          "current_enemy_remaining_hp": {
            "type": "integer",
            "title": "Current Enemy Remaining Hp"
          },
          "achieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Achieved At"
          }
        },
        "type": "object",
        "required": [
          "completed_levels",
          "current_enemy_remaining_hp",
          "achieved_at"
        ],
        "title": "BestScoreResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LeaderboardItem": {
        "properties": {
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "completed_levels": {
            "type": "integer",
            "title": "Completed Levels"
          },
          "current_enemy_remaining_hp": {
            "type": "integer",
            "title": "Current Enemy Remaining Hp"
          },
          "achieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Achieved At"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "username",
          "completed_levels",
          "current_enemy_remaining_hp",
          "achieved_at"
        ],
        "title": "LeaderboardItem"
      },
      "LeaderboardResponse": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/LeaderboardItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "page",
          "page_size",
          "total",
          "items"
        ],
        "title": "LeaderboardResponse"
      },
      "NullableBestScoreResponse": {
        "properties": {
          "best_score": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BestScoreResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "best_score"
        ],
        "title": "NullableBestScoreResponse"
      },
      "PersonalScoreItem": {
        "properties": {
          "completed_levels": {
            "type": "integer",
            "title": "Completed Levels"
          },
          "current_enemy_remaining_hp": {
            "type": "integer",
            "title": "Current Enemy Remaining Hp"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "completed_levels",
          "current_enemy_remaining_hp",
          "duration_ms",
          "created_at"
        ],
        "title": "PersonalScoreItem"
      },
      "PersonalScoresResponse": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PersonalScoreItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "page",
          "page_size",
          "items"
        ],
        "title": "PersonalScoresResponse"
      },
      "RunClaimRequest": {
        "properties": {
          "claim_token": {
            "type": "string",
            "minLength": 1,
            "title": "Claim Token"
          }
        },
        "type": "object",
        "required": [
          "claim_token"
        ],
        "title": "RunClaimRequest"
      },
      "RunClaimResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "claimed": {
            "type": "boolean",
            "title": "Claimed"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "claimed"
        ],
        "title": "RunClaimResponse"
      },
      "RunStartResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "claim_token": {
            "type": "string",
            "title": "Claim Token"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "claim_token",
          "started_at"
        ],
        "title": "RunStartResponse"
      },
      "ScoreSubmitRequest": {
        "properties": {
          "claim_token": {
            "type": "string",
            "minLength": 1,
            "title": "Claim Token"
          },
          "completed_levels": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Completed Levels"
          },
          "current_enemy_remaining_hp": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Current Enemy Remaining Hp"
          },
          "duration_ms": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "claim_token",
          "completed_levels",
          "current_enemy_remaining_hp",
          "duration_ms"
        ],
        "title": "ScoreSubmitRequest"
      },
      "ScoreSubmitResponse": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "is_personal_best": {
            "type": "boolean",
            "title": "Is Personal Best"
          }
        },
        "type": "object",
        "required": [
          "accepted",
          "is_personal_best"
        ],
        "title": "ScoreSubmitResponse"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "TokenResponse"
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "title": "UserResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/auth/login"
          }
        }
      }
    }
  }
}
